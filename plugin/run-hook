#!/bin/sh
# Pure local dispatch: reader must not depend on Kimi's hidden Node entry point.
export KIMI_CODE_NO_AUTO_UPDATE=1
export PYTHONUTF8=1
[ "$#" -gt 0 ] || set -- hook
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
case "$(uname -s)" in
  Linux) platform=linux ;;
  Darwin) platform=darwin ;;
  *) [ "$1" = hook ] && exit 0; exit 1 ;;
esac
case "$(uname -m)" in
  x86_64|amd64) arch=x64 ;;
  arm64|aarch64) arch=arm64 ;;
  *) [ "$1" = hook ] && exit 0; exit 1 ;;
esac
binary="$root/runtime/$platform-$arch/kimi-codex-memory/kimi-codex-memory"
if [ ! -x "$binary" ]; then
  [ "$1" = hook ] && exit 0
  printf '%s\n' 'Install the native release plugin, not a source archive.' >&2
  exit 1
fi
"$binary" "$@"
status=$?
[ "$1" = hook ] && exit 0
exit "$status"
