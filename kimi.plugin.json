{
  "name": "kimi-codex-memory",
  "version": "1.0.4",
  "description": "External memory v2 with offline reading and background generation",
  "license": "Apache-2.0",
  "hooks": [
    {
      "event": "SessionStart",
      "command": "\"plugin/run-hook\" hook",
      "timeout": 5
    },
    {
      "event": "UserPromptSubmit",
      "command": "\"plugin/run-hook\" hook",
      "timeout": 5
    },
    {
      "event": "TurnStarted",
      "command": "\"plugin/run-hook\" hook",
      "timeout": 5
    },
    {
      "event": "Stop",
      "command": "\"plugin/run-hook\" hook",
      "timeout": 5
    },
    {
      "event": "SessionEnd",
      "command": "\"plugin/run-hook\" hook",
      "timeout": 5
    },
    {
      "event": "Interrupt",
      "command": "\"plugin/run-hook\" hook",
      "timeout": 5
    },
    {
      "event": "StopFailure",
      "command": "\"plugin/run-hook\" hook",
      "timeout": 5
    },
    {
      "event": "PostCompact",
      "command": "\"plugin/run-hook\" hook",
      "timeout": 5
    }
  ]
}
